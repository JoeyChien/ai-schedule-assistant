# 所有 API 金鑰（Gemini / LINE / Google）都存放在 Rails encrypted credentials，
# 用 `bin/rails credentials:edit` 編輯，格式如下：
#
#   gemini:
#     api_key: ...
#   line:
#     channel_secret: ...
#     channel_access_token: ...
#   google:
#     client_id: ...
#     client_secret: ...
#     refresh_token: ...   # 用 `bin/rails google:authorize` 產生
#
# 這個檔案保留給非機密、只影響本機開發環境的變數用（例如 PORT）。

# Supabase
SUPABASE_URL=
SUPABASE_KEY=
