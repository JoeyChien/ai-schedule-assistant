# Gemini
# 實際 API Key 存放於 Rails encrypted credentials（bin/rails credentials:edit），
# 格式為 gemini: { api_key: ... }，這裡不需要填。

# LINE
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Google（GOOGLE_REFRESH_TOKEN 可用 `bin/rails google:authorize` 產生）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Supabase
SUPABASE_URL=
SUPABASE_KEY=